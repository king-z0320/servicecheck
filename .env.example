# DeepSeek API key.
# The variable name is retained for compatibility, although the current
# gateway calls the official DeepSeek API rather than OpenRouter.
openrouter_api_key=your-deepseek-api-key

# DeepSeek model used by the quality-analysis service.
model_name=deepseek-chat

# Base URL of the local/mock action-audit service.
audit_service_url=http://127.0.0.1:5002
