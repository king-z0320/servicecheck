# DeepSeek official API. Never commit a real key.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TIMEOUT_SECONDS=60

# Local/mock action-audit service.
AUDIT_SERVICE_URL=http://127.0.0.1:5002

# Optional override. Omit to use knowledge/rag_calibration.json (0.6855).
# RAG_MIN_SUPPORT_SCORE=0.6855

# Flask debug is off unless explicitly enabled for local development.
FLASK_DEBUG=false
